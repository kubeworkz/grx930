# Freebuff app state
.freebuff/

# Icarus build artifacts and waveform dumps
c930/build/
*.vcd

# Xilinx/Vivado installers and synthesis artifacts (re-downloadable)
FPGAs_AdaptiveSoCs_Unified_SDI_*.exe
FPGAs_AdaptiveSoCs_Unified_SDI_*.bin
Xilinx_Unified_*.exe
*.bit
*.ltx
c930/synth_xilinx/vivado/
c930/synth_xilinx/*.jou
c930/synth_xilinx/*.log
c930/synth_xilinx/*.runs/
c930/synth_xilinx/*.cache/
c930/synth_xilinx/*.hw/
c930/synth_xilinx/*.srcs/

# Compiled firmware binaries (rebuildable)
c930/sw/*.hex
c930/sw/*.elf
c930/sw/*.bin

# Temp simulation logs
c930/Cï*
/tmp/soc_*.log
c930/soc_*.log
c930/soc_bench_*.log

# Vendored xpack RISC-V toolchain (re-downloadable; see c930/toolchain/README.md)
c930/toolchain/*
!c930/toolchain/README.md

# rv64imac upstream clone: the RTL (with C930 fixes), the FPGA flow's cache
# sources, and the README are vendored
rv64imac/*
!rv64imac/RTL/
!rv64imac/README.md

# The FPGA flow builds from its own copies. Keep the seven cache sources that
# carry the index/tag split tracked alongside the RTL; the rest of the FPGA tree
# (bitstream, constraints, programs, Vivado output) stays a local workspace.
!rv64imac/FPGA/
rv64imac/FPGA/*
!rv64imac/FPGA/src/
rv64imac/FPGA/src/*
!rv64imac/FPGA/src/riscv_core_dcache_controller.sv
!rv64imac/FPGA/src/riscv_core_dcache_memory.sv
!rv64imac/FPGA/src/riscv_core_dcache_top.sv
!rv64imac/FPGA/src/riscv_core_icache_controller.sv
!rv64imac/FPGA/src/riscv_core_icache_memory.sv
!rv64imac/FPGA/src/riscv_core_icache_top.sv
!rv64imac/FPGA/src/riscv_core_top.sv

# Personal FlexLM license files (never commit these)
*.lic
*.lic.txt

# Vivado journal/log at repo root
vivado.jou
vivado.log

# The test-chip boot image is the checked-in firmware build the tapeout boot
# testbench preloads (../tb/tb_grx930_test_chip.sv); rebuilding needs the
# RISC-V toolchain, so this one hex is kept in the tree.
!c930/sw/test_chip_boot.hex
